# ============================================================
# Supabase — CMS database + admin authentication
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key also works
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Settings > API Keys > Secret key (server only)
SUPABASE_SECRET_KEY=
# Legacy service_role key is also supported
SUPABASE_SERVICE_ROLE_KEY=
# Optional separate HMAC secret for member sessions. If omitted, the server-side
# Supabase secret key is used only to sign the app's own member cookie.
MEMBER_SESSION_SECRET=
ADMIN_EMAILS=admin@example.com

# ============================================================
# Cloudinary — signed image uploads (server-side secret only)
# ============================================================
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Drive — list photos from publicly shared project folders
GOOGLE_DRIVE_API_KEY=

# ============================================================
# Optional booking notifications
# ============================================================

# 1. Telegram Bot (nhận thông báo Call Sheet ngay lập tức trong group Ekip)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Discord / Slack / Google Apps Script Webhook URL (ghi thẳng vào Google Sheets)
BOOKING_WEBHOOK_URL=

# Domain chính thức dùng cho OpenGraph Press Pass & Sitemap SEO
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
