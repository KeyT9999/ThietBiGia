# ============================================================
# THIẾT BỊ GIA — CẤU HÌNH THÔNG BÁO CALL SHEET REALTIME (TÙY CHỌN)
# Copy sang .env.local nếu muốn nhận tin nhắn đặt lịch ngay về điện thoại
# ============================================================

# 1. Telegram Bot (nhận thông báo Call Sheet ngay lập tức trong group Ekip)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Discord / Slack / Google Apps Script Webhook URL (ghi thẳng vào Google Sheets)
BOOKING_WEBHOOK_URL=

# 3. Domain chính thức dùng cho OpenGraph Press Pass & Sitemap SEO
NEXT_PUBLIC_SITE_URL=https://thietbigia.vn
